  "compilerOptions": {
    "target": "ES2017",
    "module": "CommonJS",
    "lib": ["ES2017"],
    "strict": true,
    "outDir": "build",
    "declaration": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
