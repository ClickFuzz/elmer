# Copy this file to .env and fill in values.
# server/.env is gitignored — never commit secrets.

# ── AI ───────────────────────────────────────────────────────────────────────
# Required for real transcription and content generation.
# Without this the server returns a clearly labelled mock response.
OPENAI_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── Database ─────────────────────────────────────────────────────────────────
# Path to the server-side SQLite file.
# Defaults to server/elmer.db when unset.
# Use :memory: for ephemeral testing only.
# DB_PATH=./elmer.db

# ── Authentication ────────────────────────────────────────────────────────────
# Session lifetime in days (default: 30).
# SESSION_TTL_DAYS=30

# Set to true to allow /api/generate without a Bearer token.
# Use ONLY during local development while the mobile app does not yet send tokens.
# NEVER set this in production.
DISABLE_AUTH=true

# ── Facebook / Meta ──────────────────────────────────────────────────────────
# Required for Facebook Pages OAuth and publishing.
# Create a Meta App at https://developers.facebook.com/ (type: Business)
# Add Facebook Login and Pages API products.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Must match the "Valid OAuth Redirect URI" in Meta App Dashboard > Facebook Login > Settings.
# In production: https://your-domain.com/facebook/callback
# For local tunnel (e.g. ngrok): https://your-subdomain.ngrok.io/facebook/callback
FACEBOOK_REDIRECT_URI=
# Custom URI scheme Elmer uses to return from the browser after OAuth.
# Must match the scheme in app.json. Default: elmer
# FACEBOOK_OAUTH_RETURN_SCHEME=elmer

# ── Credential encryption ─────────────────────────────────────────────────────
# 64-character hex string (32 bytes) used to encrypt OAuth tokens at rest.
# Required when connecting Google or Facebook accounts.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Max AI generation requests per IP per 15 minutes (default: 10).
# GENERATE_RATE_LIMIT=10
# Max auth requests per IP per 15 minutes (default: 20).
# AUTH_RATE_LIMIT=20
# Set to true to disable rate limiting entirely (testing only).
# DISABLE_RATE_LIMIT=false
