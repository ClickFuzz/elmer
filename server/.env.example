# Copy this file to .env and fill in values.
# server/.env is gitignored — never commit secrets.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string — required for the server to start.
# Local development example:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elmer_dev
# Railway provides this automatically when a PostgreSQL service is linked.
DATABASE_URL=

# ── AI ───────────────────────────────────────────────────────────────────────
# Required for real transcription and content generation.
# Without this the server returns a clearly labelled mock response.
OPENAI_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Authentication ────────────────────────────────────────────────────────────
# Session lifetime in days (default: 30).
# SESSION_TTL_DAYS=30

# Set to true to allow /api/generate without a Bearer token.
# Use ONLY during local development while the mobile app does not yet send tokens.
# NEVER set this in production — the server refuses to start with this set to true in production.
DISABLE_AUTH=true

# ── Facebook / Meta ──────────────────────────────────────────────────────────
# Required for Facebook Pages OAuth and publishing.
# Create a Meta App at https://developers.facebook.com/ (type: Business)
# Add Facebook Login and Pages API products.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Must match the "Valid OAuth Redirect URI" in Meta App Dashboard > Facebook Login > Settings.
# In production: https://api.getelmer.com/facebook/callback
# For local tunnel (e.g. ngrok): https://your-subdomain.ngrok.io/facebook/callback
FACEBOOK_REDIRECT_URI=
# Custom URI scheme Elmer uses to return from the browser after OAuth.
# Must match the scheme in app.json. Default: elmer
# FACEBOOK_OAUTH_RETURN_SCHEME=elmer

# ── Credential encryption ─────────────────────────────────────────────────────
# 64-character hex string (32 bytes) used to encrypt OAuth tokens at rest.
# Required when connecting Google or Facebook accounts.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this value STABLE across deployments — changing it invalidates all stored tokens.
CREDENTIAL_ENCRYPTION_KEY=

# ── Instagram / Meta ─────────────────────────────────────────────────────────
# Uses the same Meta App as Facebook (same App ID/Secret) but listed separately
# for clarity. Required for Instagram OAuth and publishing.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must match the "Valid OAuth Redirect URI" in Meta App Dashboard.
# In production: https://api.getelmer.com/instagram/callback
INSTAGRAM_REDIRECT_URI=

# ── Threads / Meta ────────────────────────────────────────────────────────────
# Threads uses a SEPARATE Meta App from Facebook/Instagram.
# Create at https://developers.facebook.com/ and enable the Threads product.
THREADS_APP_ID=
THREADS_APP_SECRET=
# Must match the "Valid OAuth Redirect URI" in Meta App Dashboard > Threads.
# In production: https://api.getelmer.com/threads/callback
THREADS_REDIRECT_URI=

# ── Google Business Profile ───────────────────────────────────────────────────
# Create a GCP project at https://console.cloud.google.com/
# Enable: My Business API, My Business Account Management API,
#         My Business Business Information API
# Create an OAuth 2.0 Client ID (Web application type).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI in GCP OAuth client settings.
# In production: https://api.getelmer.com/google/callback
GOOGLE_REDIRECT_URI=

# ── WordPress ────────────────────────────────────────────────────────────────
# Callback URL WordPress redirects to after Application Password authorization.
# Must be publicly accessible HTTPS. Defaults to SERVER_URL + /wordpress/callback.
# In production: https://api.getelmer.com/wordpress/callback
# WORDPRESS_CALLBACK_URL=https://api.getelmer.com/wordpress/callback

# ── Server public URL (required for Instagram, Threads, Google image serving) ─
# Base URL this server is reachable at — used to construct temporary image URLs
# that platform APIs fetch during publish. Must be publicly accessible.
# In production: https://api.getelmer.com
# For local tunnel: https://your-subdomain.ngrok.io
SERVER_URL=

# ── Stripe billing ────────────────────────────────────────────────────────────
# Use the same variable names in both environments; set the appropriate key value:
#   Production:  STRIPE_SECRET_KEY=sk_live_…  (live key from dashboard.stripe.com/apikeys)
#   Staging:     STRIPE_SECRET_KEY=sk_test_…  (test key from dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# STRIPE_TEST_MODE controls DeviceCheck bypass and the Developer tools UI in the app.
# It does NOT select credentials — set this independently of the key type above.
#   Staging:    STRIPE_TEST_MODE=true   (bypasses DeviceCheck so repeated test-account
#                                        sign-ups don't consume Apple DeviceCheck slots)
#   Production: STRIPE_TEST_MODE=false  (or omit entirely)
# FATAL if STRIPE_SECRET_KEY starts with sk_live_ while this is true.
STRIPE_TEST_MODE=false

# ── Legacy (deprecated) ────────────────────────────────────────────────────────
# These STRIPE_TEST_* names were used before the unified variable scheme.
# The server still reads them as a fallback while Railway staging environments
# are migrated to set STRIPE_SECRET_KEY=sk_test_… directly. Remove after migration.
# STRIPE_TEST_SECRET_KEY=
# STRIPE_TEST_WEBHOOK_SECRET=
# STRIPE_TEST_PRICE_ID=

# ── Apple DeviceCheck (iOS abuse prevention) ─────────────────────────────────
# Enables device-level free-post tracking via Apple DeviceCheck (iOS real devices only).
# All three vars must be set together; if any is absent DeviceCheck is disabled (fail-open).
#
# APPLE_DEVICECHECK_KEY_ID   — 10-character key ID from Apple Developer > Keys
# APPLE_DEVICECHECK_TEAM_ID  — 10-character Team ID from Apple Developer membership page
# APPLE_DEVICECHECK_PRIVATE_KEY — contents of the .p8 key file (full PEM including BEGIN/END lines)
#   On Railway, store newlines as the literal sequence \n (Railway escapes them automatically).
#   Generate: Apple Developer > Certificates, Identifiers & Profiles > Keys > Create Key >
#             tick "DeviceCheck" > Download (.p8 — can only be downloaded once).
#
# For local development against the sandbox API:
# APPLE_DEVICECHECK_USE_SANDBOX=true   (omit or set false for production)
#
APPLE_DEVICECHECK_KEY_ID=
APPLE_DEVICECHECK_TEAM_ID=
APPLE_DEVICECHECK_PRIVATE_KEY=
# APPLE_DEVICECHECK_USE_SANDBOX=false

# ── PostHog analytics ─────────────────────────────────────────────────────────
# Server-side event tracking for conversion funnel and publishing analytics.
# If absent, analytics are silently disabled — product behavior is unaffected.
# Obtain from: posthog.com > Project Settings > Project API Key
POSTHOG_API_KEY=
# PostHog ingestion host. US region: https://us.i.posthog.com
# EU region: https://eu.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Max AI generation requests per IP per 15 minutes (default: 10).
# GENERATE_RATE_LIMIT=10
# Max auth requests per IP per 15 minutes (default: 20).
# AUTH_RATE_LIMIT=20
# Set to true to disable rate limiting entirely (testing only).
# DISABLE_RATE_LIMIT=false
