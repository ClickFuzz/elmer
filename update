#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")"

if [[ "$(git branch --show-current)" != "staging" ]]; then
  echo "ERROR: You must be on the staging branch."
  exit 1
fi

read -r -p "Update message: " MESSAGE

if [[ -z "${MESSAGE//[[:space:]]/}" ]]; then
  echo "ERROR: Update message cannot be empty."
  exit 1
fi

# Write staging overrides to .env.local before bundling.
# @expo/env loads .env.local after .env, so these values win over the
# production .env file that lives at the repo root.
ENV_LOCAL=".env.local"
cleanup() { rm -f "$ENV_LOCAL"; }
trap cleanup EXIT

cat > "$ENV_LOCAL" <<'ENVEOF'
APP_VARIANT=staging
EXPO_PUBLIC_API_URL=https://api-staging.getelmer.com
EXPO_PUBLIC_APP_SCHEME=elmer-staging
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_INSTAGRAM_ENABLED=true
ENVEOF

echo ""
echo "Publishing Elmer Staging OTA update..."
echo "Message: $MESSAGE"
echo ""

npx eas-cli@latest update \
  --branch staging \
  --platform ios \
  --message "$MESSAGE"

echo ""
echo "Staging OTA update published successfully."
