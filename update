#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")"

if [[ "$(git branch --show-current)" != "staging" ]]; then
  echo "ERROR: You must be on the staging branch."
  exit 1
fi

read -r -p "Update message: " MESSAGE

if [[ -z "${MESSAGE//[[:space:]]/}" ]]; then
  echo "ERROR: Update message cannot be empty."
  exit 1
fi

# @expo/env loads .env.local first then .env, with .env winning (override mode).
# The only reliable way to inject staging values is to replace .env itself.
# Back it up and restore it on exit (success, error, or Ctrl-C).
ENV_FILE=".env"
ENV_BACKUP=".env.ota-backup"

if [[ -f "$ENV_FILE" ]]; then
  cp "$ENV_FILE" "$ENV_BACKUP"
fi

cleanup() {
  if [[ -f "$ENV_BACKUP" ]]; then
    mv "$ENV_BACKUP" "$ENV_FILE"
  elif [[ -f "$ENV_FILE" ]]; then
    rm -f "$ENV_FILE"
  fi
  rm -f ".env.local"
}
trap cleanup EXIT

cat > "$ENV_FILE" <<'ENVEOF'
APP_VARIANT=staging
EXPO_PUBLIC_API_URL=https://api-staging.getelmer.com
EXPO_PUBLIC_APP_SCHEME=elmer-staging
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_API_KEY=phc_yUHWWiu7B4Adyji8ZqkcpA3XUEM5eWA5DfVZnrs5Q8i9
EXPO_PUBLIC_INSTAGRAM_ENABLED=true
ENVEOF

echo ""
echo "Publishing Elmer Staging OTA update..."
echo "Message: $MESSAGE"
echo ""

npx eas-cli@latest update \
  --branch staging \
  --platform ios \
  --message "$MESSAGE"

echo ""
echo "Staging OTA update published successfully."
